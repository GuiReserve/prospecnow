# Copie para .env.local (local) ou cadastre na Vercel em Settings > Environment Variables.
# Nunca coloque essas chaves no código nem mande por chat.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mapa e dados: OpenFreeMap + OpenStreetMap. Não precisam de chave.

# IA (Anthropic), opcional: planeja as cidades da varredura e reescreve mensagens
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Asaas (sandbox para testes; production só ao cobrar de verdade)
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
NEXT_PUBLIC_SITE_URL=https://prospecnow.vercel.app

# E-mail para pedidos de LGPD
NEXT_PUBLIC_CONTATO_EMAIL=

# Modo de demonstração (1 = roda sem chaves, com dados de exemplo). Deixe vazio em produção.
NEXT_PUBLIC_MOCK=
