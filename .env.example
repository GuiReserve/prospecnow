# Copie para .env.local (local) ou cadastre na Vercel em Settings > Environment Variables.
# Nunca coloque essas chaves no código nem mande por chat.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps Platform
# Chave do navegador (restrita ao seu domínio, só Maps JavaScript API)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# Map ID vetorial (Google Cloud > Map Management), necessário para o 3D
NEXT_PUBLIC_GOOGLE_MAP_ID=
# Chave do servidor (restrita à Places API (New)), nunca exposta no navegador
GOOGLE_PLACES_KEY=

# IA (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Asaas
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=

# E-mail para pedidos de LGPD
NEXT_PUBLIC_CONTATO_EMAIL=

# Modo de demonstração (1 = roda sem chaves, com dados de exemplo). Deixe vazio em produção.
NEXT_PUBLIC_MOCK=
